# From @BotFather (step 1 of the README)
TELEGRAM_BOT_TOKEN=
# From `chat-id` (step 2 of the README). The admin: gets the alerts and approves who else may use the bot.
TELEGRAM_CHAT_ID=
# Optional — GET /api/status in JSON (the same as /status). Off without HTTP_PORT.
# Without HTTP_TOKEN it only answers on localhost; with it, send `Authorization: Bearer <token>`.
# HTTP_PORT=8080
# HTTP_TOKEN=
# Optional — override services.json
# STATUSBOT_LANGUAGE=pt
# STATUSBOT_INTERVAL=300
